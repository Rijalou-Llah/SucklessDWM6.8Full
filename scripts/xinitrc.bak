# 1. MONITOR DETECTION LAYOUT
if [ "$(hostname)" = "gentoo-nuc" ]; then
    # Specific layout for your Gentoo NUC
    xrandr --output HDMI-2 --mode 1920x1080 --rate 60.00 --pos 0x0 \
           --output HDMI-1 --mode 1024x768 --rate 60.00 --below HDMI-2
else
    # Safe fallback configuration for your other PC (Automatic detection)
    xrandr --auto
fi

# 2. Configure display behaviors
xset s off
xset -dpms
export GTK_THEME=Adwaita-dark

# 3. Start audio and system utilities
pipewire &
pipewire-pulse &
wireplumber &
clipmenud &

# 4. Start your status bars
slstatus &

# 5. Launch Window Manager
exec dwm
